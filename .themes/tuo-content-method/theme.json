{
  "specVersion": "1.0",
  "id": "tuo-content-method",
  "version": "1.0.0",
  "name": "黑色幽默",
  "description": "暖纸白、柔和炭黑与哑光金的结构化教程主题，适合方法论、内容创作和知识文章。",
  "recommendation": {
    "summary": "CONTENT METHOD",
    "articleTypes": [
      "opinion-knowledge",
      "tutorial",
      "list-driven"
    ],
    "tones": [
      "structured",
      "warm",
      "methodical"
    ],
    "structurePatterns": [
      "argument-evidence-conclusion",
      "list-driven"
    ]
  },
  "defaultDensity": "balanced",
  "essay": {
    "flow": {
      "label": "正文流动",
      "visualWeight": "quiet",
      "surface": "open",
      "emphasisCost": 0,
      "styles": {}
    },
    "pause": {
      "label": "短句停顿",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "border-left": "2px solid {color.accent}",
          "padding-left": "14px"
        }
      }
    },
    "pivot": {
      "label": "论述转场",
      "visualWeight": "medium",
      "surface": "panel",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "background-color": "{color.soft}",
          "padding": "18px",
          "border-radius": "{radius}"
        }
      }
    },
    "release": {
      "label": "结尾余韵",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "color": "{color.accent}",
          "text-align": "center"
        }
      }
    }
  },
  "tokens": {
    "color": {
      "paper": "#FCFAF5",
      "ink": "#3A3732",
      "muted": "#7C7468",
      "accent": "#B08A52",
      "soft": "#EDE4D3"
    },
    "type": {
      "body": "-apple-system, BlinkMacSystemFont, PingFang SC, Helvetica Neue, STHeiti, sans-serif",
      "heading": "-apple-system, BlinkMacSystemFont, PingFang SC, Helvetica Neue, STHeiti, sans-serif"
    },
    "size": {
      "title": "29px",
      "heading": "17px",
      "body": "14px",
      "meta": "11px"
    },
    "lineHeight": {
      "body": "1.85",
      "heading": "1.6",
      "compact": "1.5"
    },
    "alignment": {
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#F7F5EF",
      "padding": "0 20px 96px"
    },
    "radius": "24px"
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 9,
        "flow": 19,
        "break": 31,
        "turn": 44,
        "section": 62,
        "release": 75
      },
      "balanced": {
        "close": 12,
        "flow": 24,
        "break": 40,
        "turn": 56,
        "section": 80,
        "release": 96
      },
      "airy": {
        "close": 15,
        "flow": 31,
        "break": 51,
        "turn": 72,
        "section": 102,
        "release": 123
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "break",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "flow",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.3,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/minor/component.json",
    "components/lead/component.json",
    "components/prose/component.json",
    "components/focus/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/callout/component.json",
    "components/cta/component.json",
    "components/image/component.json",
    "components/ending/component.json"
  ]
}
