{
  "specVersion": "1.0",
  "id": "masthead",
  "template": "template.html",
  "kind": "masthead",
  "accepts": {
    "blockTypes": [
      "article-title"
    ]
  },
  "slots": [
    {
      "name": "content",
      "source": "content",
      "required": true
    }
  ],
  "fallbackVariant": "source",
  "baseStyles": {
    "r0": {
      "margin": "0 13px",
      "padding": "28px 24px 32px",
      "border-radius": "28px",
      "text-align": "left"
    },
    "r1": {
      "margin": "0 0 28px",
      "padding": "0"
    },
    "r2": {
      "aspect-ratio": "16 / 10",
      "overflow": "hidden"
    },
    "r3": {
      "display": "block",
      "width": "100%",
      "height": "100%",
      "object-fit": "cover"
    },
    "r4": {
      "display": "flex",
      "align-items": "center",
      "gap": "12px",
      "margin": "0 0 32px",
      "color": "#c49a6c",
      "font-family": "Iowan Old Style, STSong, Songti SC, Georgia, serif",
      "font-size": "10px",
      "letter-spacing": ".25em"
    },
    "r5": {
      "display": "inline-block",
      "width": "32px",
      "height": "1px"
    },
    "r6": {
      "margin": "0",
      "color": "#18261f",
      "font-family": "LXGW WenKai, LXGW WenKai Mono TC, Songti SC, Georgia, serif",
      "font-size": "23px",
      "font-weight": "700",
      "line-height": "1.35",
      "letter-spacing": ".12em"
    },
    "r7": {
      "margin": "20px 0 0",
      "color": "#4a6d5a",
      "font-family": "LXGW WenKai, LXGW WenKai Mono TC, Songti SC, Georgia, serif",
      "font-size": "14px",
      "font-weight": "400",
      "line-height": "1.7",
      "letter-spacing": ".1em"
    },
    "r8": {
      "margin": "40px 0 0",
      "padding-top": "20px",
      "border-top": "1px solid #ebe8df",
      "color": "#7d8490",
      "font-family": "Iowan Old Style, STSong, Songti SC, Georgia, serif",
      "font-size": "11px",
      "letter-spacing": ".1em"
    }
  },
  "variants": [
    {
      "id": "source",
      "label": "TUO masthead",
      "priority": 60,
      "visualWeight": "strong",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {}
    }
  ]
