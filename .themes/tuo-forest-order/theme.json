{
  "specVersion": "1.0",
  "id": "tuo-forest-order",
  "version": "1.0.0",
  "name": "森序长文",
  "description": "深森林绿、香槟金与章节留白构成的正式编辑排版。",
  "recommendation": {
    "summary": "FOREST ORDER",
    "articleTypes": [
      "literary-prose",
      "personal-essay"
    ],
    "tones": [
      "formal",
      "calm",
      "narrative"
    ],
    "structurePatterns": [
      "narrative-reflection",
      "experience-reflection-conclusion"
    ]
  },
  "defaultDensity": "balanced",
  "essay": {
    "flow": {
      "label": "正文流动",
      "visualWeight": "quiet",
      "surface": "open",
      "emphasisCost": 0,
      "styles": {}
    },
    "pause": {
      "label": "短句停顿",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "border-left": "2px solid {color.accent}",
          "padding-left": "14px"
        }
      }
    },
    "pivot": {
      "label": "论述转场",
      "visualWeight": "medium",
      "surface": "panel",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "background-color": "{color.soft}",
          "padding": "18px",
          "border-radius": "{radius}"
        }
      }
    },
    "release": {
      "label": "结尾余韵",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "color": "{color.accent}",
          "text-align": "center"
        }
      }
    }
  },
  "tokens": {
    "color": {
      "paper": "#fafaf7",
      "ink": "#333333",
      "muted": "#555555",
      "accent": "#11413e",
      "soft": "#e3d9c6"
    },
    "type": {
      "body": "PingFang SC, Microsoft YaHei, sans-serif",
      "heading": "Noto Serif SC, Songti SC, STSong, Georgia, serif"
    },
    "size": {
      "title": "29px",
      "heading": "17px",
      "body": "14px",
      "meta": "11px"
    },
    "lineHeight": {
      "body": "1.85",
      "heading": "1.6",
      "compact": "1.5"
    },
    "alignment": {
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#f4f3ee",
      "padding": "0 20px 96px"
    },
    "radius": "4px"
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 8,
        "flow": 16,
        "break": 22,
        "turn": 34,
        "section": 50,
        "release": 62
      },
      "balanced": {
        "close": 10,
        "flow": 20,
        "break": 28,
        "turn": 44,
        "section": 64,
        "release": 80
      },
      "airy": {
        "close": 13,
        "flow": 26,
        "break": 36,
        "turn": 56,
        "section": 82,
        "release": 102
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "break",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "flow",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.3,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/minor/component.json",
    "components/lead/component.json",
    "components/prose/component.json",
    "components/focus/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/callout/component.json",
    "components/cta/component.json",
    "components/image/component.json",
    "components/ending/component.json"
  ]
}
