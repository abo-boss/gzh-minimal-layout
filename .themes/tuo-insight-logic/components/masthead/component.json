{
  "specVersion": "1.0",
  "id": "masthead",
  "template": "template.html",
  "kind": "masthead",
  "accepts": {
    "blockTypes": [
      "article-title"
    ]
  },
  "slots": [
    {
      "name": "content",
      "source": "content",
      "required": true
    }
  ],
  "fallbackVariant": "source",
  "baseStyles": {
    "r0": {
