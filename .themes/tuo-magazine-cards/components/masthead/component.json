{
  "specVersion": "1.0",
  "id": "masthead",
  "template": "template.html",
  "kind": "masthead",
  "accepts": {
    "blockTypes": [
      "article-title"
    ]
  },
  "slots": [
    {
      "name": "content",
      "source": "content",
      "required": true
    }
  ],
  "fallbackVariant": "source",
  "baseStyles": {
    "r0": {
      "margin": "0 0 28px"
    },
    "r1": {
      "display": "inline-block",
      "margin": "0 0 24px",
      "padding": "6px 12px",
      "border-radius": "999px",
      "color": "#9e8870",
      "font-family": "Noto Serif SC, Songti SC, Georgia, serif",
      "font-size": "11px",
      "font-weight": "600",
      "letter-spacing": ".08em"
    },
    "r2": {
      "margin": "0",
      "color": "#262626",
      "font-family": "Noto Serif SC, Songti SC, Georgia, serif",
      "font-size": "23px",
      "font-weight": "700",
      "line-height": "1.35",
      "letter-spacing": "-.03em"
    },
    "r3": {
      "display": "block",
      "width": "40px",
      "margin": "24px 0",
      "border-top": "2px solid #9e8870"
    },
    "r4": {
      "margin": "28px 0 0",
      "padding": "0"
    },
    "r5": {
      "aspect-ratio": "16 / 9",
      "overflow": "hidden",
      "border-radius": "0px"
    },
    "r6": {
      "display": "block",
      "width": "100%",
      "height": "100%",
      "object-fit": "cover",
      "border-radius": "0px",
      "opacity": ".9"
    },
    "r7": {
      "display": "block",
      "margin-top": "16px",
      "color": "#66635b",
      "font-family": "Iowan Old Style, STSong, Songti SC, Georgia, serif",
      "font-size": "11px",
      "line-height": "1.7",
      "letter-spacing": ".05em",
      "text-align": "center",
      "font-style": "italic"
    }
  },
  "variants": [
    {
      "id": "source",
      "label": "TUO masthead",
      "priority": 60,
      "visualWeight": "strong",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {}
    }
  ]
}
