{
  "specVersion": "1.0",
  "id": "tuo-magazine-cards",
  "version": "1.0.0",
  "name": "杂志卡片",
  "description": "乳白纸卡、弱化编号与大章节分组，强调一章一张完整阅读卡片。",
  "recommendation": {
    "summary": "THE ART OF WHITESPACE",
    "articleTypes": [
      "personal-essay",
      "literary-prose"
    ],
    "tones": [
      "editorial",
      "warm",
      "narrative"
    ],
    "structurePatterns": [
      "narrative-reflection",
      "experience-reflection-conclusion"
    ]
  },
  "defaultDensity": "balanced",
  "essay": {
    "flow": {
      "label": "正文流动",
      "visualWeight": "quiet",
      "surface": "open",
      "emphasisCost": 0,
      "styles": {}
    },
    "pause": {
      "label": "短句停顿",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "border-left": "2px solid {color.accent}",
          "padding-left": "14px"
        }
      }
    },
    "pivot": {
      "label": "论述转场",
      "visualWeight": "medium",
      "surface": "panel",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "background-color": "{color.soft}",
          "padding": "18px",
          "border-radius": "{radius}"
        }
      }
    },
    "release": {
      "label": "结尾余韵",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "color": "{color.accent}",
          "text-align": "center"
        }
      }
    }
  },
  "tokens": {
    "color": {
      "paper": "#f8f8f5",
      "ink": "#262626",
      "muted": "#66635b",
      "accent": "#9e8870",
      "soft": "#efece6"
    },
    "type": {
      "body": "Noto Sans SC, -apple-system, BlinkMacSystemFont, sans-serif",
      "heading": "Noto Serif SC, Songti SC, Georgia, serif"
    },
    "size": {
      "title": "29px",
      "heading": "17px",
      "body": "14px",
      "meta": "11px"
    },
    "lineHeight": {
      "body": "1.9",
      "heading": "1.6",
      "compact": "1.5"
    },
    "alignment": {
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#f4f3ee",
      "padding": "0 20px 96px"
    },
    "radius": "24px"
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 11,
        "flow": 19,
        "break": 31,
        "turn": 44,
        "section": 56,
        "release": 69
      },
      "balanced": {
        "close": 14,
        "flow": 24,
        "break": 40,
        "turn": 56,
        "section": 72,
        "release": 88
      },
      "airy": {
        "close": 18,
        "flow": 31,
        "break": 51,
        "turn": 72,
        "section": 92,
        "release": 113
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "break",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "flow",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.3,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/minor/component.json",
    "components/lead/component.json",
    "components/prose/component.json",
    "components/focus/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/callout/component.json",
    "components/cta/component.json",
    "components/image/component.json",
    "components/ending/component.json"
  ]
}
