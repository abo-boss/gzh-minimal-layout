{
  "specVersion": "1.0",
  "id": "masthead",
  "template": "template.html",
  "kind": "masthead",
  "accepts": {
    "blockTypes": [
      "article-title"
    ]
  },
  "slots": [
    {
      "name": "content",
      "source": "content",
      "required": true
    }
  ],
  "fallbackVariant": "source",
  "baseStyles": {
    "r0": {
      "margin": "-36px 0 40px"
    },
    "r1": {
      "aspect-ratio": "16 / 9",
      "overflow": "hidden"
    },
    "r2": {
      "display": "block",
      "width": "100%",
      "height": "100%",
      "object-fit": "cover",
      "opacity": ".9",
      "border-radius": "0px"
    },
    "r3": {
      "margin": "0",
      "text-align": "center"
    },
    "r4": {
      "display": "inline-block",
      "margin": "0",
      "color": "#8c9b8b",
      "font-family": "Iowan Old Style, STSong, Songti SC, Georgia, serif",
      "font-size": "11px",
      "font-weight": "700",
      "letter-spacing": "0.2em",
      "text-align": "center"
    },
    "r5": {
      "width": "48px",
      "margin": "12px auto 80px",
      "border-top": "1px solid #8c9b8b"
    },
    "r6": {
      "margin": "0",
      "color": "#2c2c2c",
      "font-family": "Noto Serif SC, Songti SC, STSong, Georgia, serif",
      "font-size": "29px",
      "font-weight": "700",
      "line-height": "1.6",
      "letter-spacing": "0.06em",
      "text-align": "center"
    }
  },
  "variants": [
    {
      "id": "source",
      "label": "TUO masthead",
      "priority": 60,
      "visualWeight": "strong",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {}
    }
  ]
