{
  "specVersion": "1.0",
  "id": "tuo-quiet-lifestyle",
  "version": "1.0.0",
  "name": "燕麦糙绿",
  "description": "燕麦白纸张、鼠尾草绿与宋体章节牌，适合生活观察和舒缓叙事。",
  "recommendation": {
    "summary": "LIFESTYLE OBSERVATION",
    "articleTypes": [
      "personal-essay",
      "literary-prose",
      "other"
    ],
    "tones": [
      "warm",
      "narrative",
      "calm",
      "lifestyle"
    ],
    "structurePatterns": [
      "narrative-reflection",
      "experience-reflection-conclusion"
    ]
  },
  "defaultDensity": "balanced",
  "essay": {
    "flow": {
      "label": "正文流动",
      "visualWeight": "quiet",
      "surface": "open",
      "emphasisCost": 0,
      "styles": {}
    },
    "pause": {
      "label": "短句停顿",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "border-left": "2px solid {color.accent}",
          "padding-left": "14px"
        }
      }
    },
    "pivot": {
      "label": "论述转场",
      "visualWeight": "medium",
      "surface": "panel",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "background-color": "{color.soft}",
          "padding": "18px",
          "border-radius": "{radius}"
        }
      }
    },
    "release": {
      "label": "结尾余韵",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "color": "{color.accent}",
          "text-align": "center"
        }
      }
    }
  },
  "tokens": {
    "color": {
      "paper": "#fafaf7",
      "ink": "#3f3f3f",
      "muted": "#a3a3a3",
      "accent": "#5a6a5a",
      "soft": "#e8e4d9"
    },
    "type": {
      "body": "-apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, sans-serif",
      "heading": "Noto Serif SC, Songti SC, STSong, Georgia, serif"
    },
    "size": {
      "title": "29px",
      "heading": "17px",
      "body": "14px",
      "meta": "11px"
    },
    "lineHeight": {
      "body": "1.85",
      "heading": "1.6",
      "compact": "1.5"
    },
    "alignment": {
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#f4f4f4",
      "padding": "0 20px 96px"
    },
    "radius": "4px"
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 9,
        "flow": 23,
        "break": 33,
        "turn": 50,
        "section": 62,
        "release": 75
      },
      "balanced": {
        "close": 12,
        "flow": 29,
        "break": 42,
        "turn": 64,
        "section": 80,
        "release": 96
      },
      "airy": {
        "close": 15,
        "flow": 37,
        "break": 54,
        "turn": 82,
        "section": 102,
        "release": 123
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "break",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "flow",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.3,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/minor/component.json",
    "components/lead/component.json",
    "components/prose/component.json",
    "components/focus/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/callout/component.json",
    "components/cta/component.json",
    "components/image/component.json",
    "components/ending/component.json"
  ]
}
