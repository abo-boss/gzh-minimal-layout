{
  "specVersion": "1.0",
  "id": "image",
  "template": "template.html",
  "kind": "image",
  "accepts": {
    "blockTypes": [
      "image"
    ]
  },
  "slots": [
    {
      "name": "src",
      "source": "image-src",
      "required": true
    },
    {
      "name": "alt",
      "source": "image-alt",
      "required": true
    },
    {
      "name": "caption",
      "source": "image-caption",
      "required": false
    }
  ],
  "fallbackVariant": "source",
  "baseStyles": {
    "r0": {
      "margin": "36px 0 0",
      "padding": "0",
      "width": "100%"
    },
    "r1": {
      "aspect-ratio": "16 / 10",
      "overflow": "hidden",
      "border-radius": "0px"
    },
    "r2": {
      "display": "block",
      "width": "100%",
      "height": "100%",
      "object-fit": "cover",
      "border-radius": "0px"
    },
    "r3": {
      "display": "block",
      "margin": "4px 0 0",
      "padding": "0",
      "color": "#7a7a78",
      "font-family": "Iowan Old Style, STSong, Songti SC, Georgia, serif",
      "font-size": "10px",
      "line-height": "1.4",
      "letter-spacing": ".16em",
      "text-align": "center",
      "font-style": "italic"
    }
  },
  "variants": [
    {
      "id": "source",
      "label": "TUO image",
      "priority": 60,
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {}
    }
  ]
}
