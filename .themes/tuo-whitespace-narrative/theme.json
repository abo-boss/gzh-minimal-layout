{
  "specVersion": "1.0",
  "id": "tuo-whitespace-narrative",
  "version": "1.0.0",
  "name": "石墨文书",
  "description": "米灰纸张、石墨文字与展签式细节，让内容在安静的节奏中自然展开。",
  "recommendation": {
    "summary": "THE ART OF WHITESPACE",
    "articleTypes": [
      "literary-prose",
      "personal-essay"
    ],
    "tones": [
      "quiet",
      "reflective",
      "minimal"
    ],
    "structurePatterns": [
      "narrative-reflection",
      "fragmented-prose"
    ]
  },
  "defaultDensity": "balanced",
  "essay": {
    "flow": {
      "label": "正文流动",
      "visualWeight": "quiet",
      "surface": "open",
      "emphasisCost": 0,
      "styles": {}
    },
    "pause": {
      "label": "短句停顿",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "border-left": "2px solid {color.accent}",
          "padding-left": "14px"
        }
      }
    },
    "pivot": {
      "label": "论述转场",
      "visualWeight": "medium",
      "surface": "panel",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "background-color": "{color.soft}",
          "padding": "18px",
          "border-radius": "{radius}"
        }
      }
    },
    "release": {
      "label": "结尾余韵",
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": {
        "r0": {
          "color": "{color.accent}",
          "text-align": "center"
        }
      }
    }
  },
  "tokens": {
    "color": {
      "paper": "#f9f8f6",
      "ink": "#1a1c1a",
      "muted": "#7a7a78",
      "accent": "#948777",
      "soft": "#efece6"
    },
    "type": {
      "body": "Inter, PingFang SC, Helvetica Neue, sans-serif",
      "heading": "Noto Serif SC, Songti SC, STSong, Georgia, serif"
    },
    "size": {
      "title": "29px",
      "heading": "17px",
      "body": "14px",
      "meta": "11px"
    },
    "lineHeight": {
      "body": "1.85",
      "heading": "1.6",
      "compact": "1.5"
    },
    "alignment": {
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#e5e5e5",
      "padding": "0 20px 96px"
    },
    "radius": "0px"
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 8,
        "flow": 20,
        "break": 28,
        "turn": 44,
        "section": 62,
        "release": 75
      },
      "balanced": {
        "close": 10,
        "flow": 25,
        "break": 36,
        "turn": 56,
        "section": 80,
        "release": 96
      },
      "airy": {
        "close": 13,
        "flow": 32,
        "break": 46,
        "turn": 72,
        "section": 102,
        "release": 123
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "break",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "flow",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.3,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/minor/component.json",
    "components/lead/component.json",
    "components/prose/component.json",
    "components/focus/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/callout/component.json",
    "components/cta/component.json",
    "components/image/component.json",
    "components/ending/component.json"
  ],
  "composition": {
    "structureModel": "石墨展签、宽留白与低对比细节让片段叙事和安静反思自然展开。",
    "inlineMarkBudget": { "minPerParagraph": 0, "maxPerParagraph": 4, "maxHighlightPerParagraph": 1, "maxStyleKindsPerParagraph": 2, "preferredPhraseMinChars": 3, "preferredPhraseMaxChars": 15, "maxStrongAnchorsPerArticle": 5 },
    "chrome": {
      "intro": { "enabled": true, "styles": { "root": { "margin": "10px 0 36px", "padding": "20px 8px", "border-top": "1px solid {color.soft}", "border-bottom": "1px solid {color.soft}", "text-align": "center" }, "text": { "font-family": "{type.heading}", "font-size": "18px", "font-weight": "600", "line-height": "1.8", "color": "{color.ink}" } } },
      "directory": { "enabled": true, "maxItems": 4, "styles": { "root": { "margin": "0 0 38px" }, "label": { "font-size": "12px", "font-weight": "700", "letter-spacing": "1.2px", "color": "{color.accent}", "margin-bottom": "10px" }, "list": { "border-top": "1px solid {color.soft}" }, "item": { "padding": "11px 0", "border-bottom": "1px solid {color.soft}" }, "itemNumber": { "font-size": "12px", "font-weight": "700", "color": "{color.accent}" }, "itemTitle": { "font-size": "15px", "line-height": "1.55", "color": "{color.ink}" } } },
      "chapter": { "enabled": true, "label": "CHAPTER", "styles": { "root": { "margin": "0 0 12px" }, "label": { "font-size": "12px", "font-weight": "700", "letter-spacing": "1.2px", "color": "{color.accent}" } } },
      "end": { "enabled": true, "label": "END", "styles": { "root": { "margin": "48px 0 24px", "text-align": "center" }, "line": { "border-top": "1px solid {color.soft}", "margin": "0 auto 12px", "width": "52px" }, "label": { "font-size": "12px", "letter-spacing": "2px", "font-weight": "700", "color": "{color.accent}" } } },
      "signature": { "enabled": true, "authorTemplate": "我是 {{作者名}}，{{一句话简介}}。", "ctaTemplate": "如果这篇文章对你有启发，欢迎点赞、在看、转发，让它抵达需要的人。", "styles": { "root": { "margin": "0", "padding": "20px", "background-color": "{color.soft}", "border-radius": "{radius}" }, "author": { "font-size": "15px", "line-height": "1.7", "font-weight": "600", "color": "{color.ink}" }, "cta": { "margin-top": "10px", "font-size": "14px", "line-height": "1.75", "color": "{color.muted}" } } }
    },
    "recipes": [
      {
        "id": "essay-reflection",
        "label": "经历—反思—收束",
        "articleTypes": [
          "personal-essay",
          "opinion-knowledge"
        ],
        "coreComponents": [
          "masthead",
          "heading",
          "subheading",
          "prose",
          "quote",
          "ending",
          "cta"
        ],
        "accentComponents": [
          "lead",
          "focus",
          "callout",
          "image"
        ],
        "maxAccentKinds": 2,
        "guidance": [
          "正文保持连续",
          "只突出转折或核心判断",
          "结尾与 CTA 分开"
        ]
      },
      {
        "id": "literary-narrative",
        "label": "叙事—停顿—余韵",
        "articleTypes": [
          "literary-prose",
          "personal-essay"
        ],
        "coreComponents": [
          "masthead",
          "heading",
          "subheading",
          "prose",
          "quote",
          "ending"
        ],
        "accentComponents": [
          "lead",
          "focus",
          "image"
        ],
        "maxAccentKinds": 1,
        "guidance": [
          "正文默认开放表面",
          "引用承担少量停顿",
          "结尾留白大于正文"
        ]
      },
      {
        "id": "universal",
        "label": "通用长文",
        "articleTypes": [
          "other",
          "personal-essay",
          "opinion-knowledge",
          "literary-prose",
          "tutorial",
