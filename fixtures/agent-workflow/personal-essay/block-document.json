    {
      "id": "block-003",
      "type": "heading",
      "role": "other",
      "content": "## 改变发生在一个普通清晨",
      "importance": 0.72,
      "level": 2,
      "sectionId": "section-02",
      "groupId": "group-02",
      "relationToPrevious": "new-section",
