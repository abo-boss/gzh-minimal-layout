      "role": "title",
      "content": "如何用留白，\n让一篇文章更耐读",
      "importance": 1,
      "sourceOrder": 0,
      "sectionId": "entry"
    },
    {
      "id": "lead-image",
      "type": "image",
      "role": "lead-image",
