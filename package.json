{
  "name": "gzh-minimal-layout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx scripts/cli.ts",
    "skill:validate": "python3 \"$HOME/.codex/skills/.system/skill-creator/scripts/quick_validate.py\" .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "reading:plan": "tsx scripts/cli.ts reading plan",
    "workflow:run": "tsx scripts/cli.ts workflow run",
    "layout:candidates": "tsx scripts/cli.ts layout candidates",
    "layout:plan": "tsx scripts/cli.ts layout plan",
    "wechat:render": "tsx scripts/cli.ts wechat render"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
