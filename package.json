{
  "name": "gzh-minimal-layout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node dist/scripts/cli.js",
    "cli:dev": "tsx scripts/cli.ts",
    "preview:themes": "tsx scripts/generate-theme-gallery.ts",
    "lint:themes": "tsx scripts/lint-theme-library.ts",
    "docs:themes": "tsx scripts/generate-theme-guides.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
