{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gzh-minimal-layout:schema:block-document:1.0",
  "title": "BlockDocument v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "id", "blocks"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "specVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "articleType": { "$ref": "#/$defs/id" },
    "moods": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "segmentationDecisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/segmentationDecision" }
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "blockType": {
      "enum": [
        "article-title",
        "article-subtitle",
        "metadata",
        "lead",
        "heading",
        "paragraph",
        "quote",
        "list",
        "image",
        "divider",
        "callout",
        "step",
        "table",
        "code",
        "ending",
        "cta"
      ]
    },
    "relation": {
      "enum": [
        "default",
        "same-group",
        "continuation",
        "new-argument",
        "turning-point",
        "before-strong-block",
        "after-strong-block",
        "new-section",
        "before-ending"
      ]
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start", "end"],
      "properties": {
        "type": { "enum": ["emphasis", "strong", "quote", "keyword", "highlight", "underline", "strike", "code"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "headingStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasMarker"],
      "properties": {
        "hasMarker": { "type": "boolean" },
        "marker": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "hasMarker": { "const": true } }, "required": ["hasMarker"] },
          "then": { "required": ["marker"] },
          "else": { "not": { "anyOf": [{ "required": ["marker"] }, { "required": ["ordinal"] }] } }
        }
      ]
    },
    "listItemStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "content": { "type": "string", "minLength": 1 },
        "marks": { "type": "array", "items": { "$ref": "#/$defs/mark" } }
      }
    },
    "listStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered", "items"],
      "properties": {
        "ordered": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/listItemStructure" }
        }
      }
    },
    "quoteStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "hasAttribution"],
      "properties": {
        "content": { "type": "string", "minLength": 1 },
        "hasAttribution": { "type": "boolean" },
        "attribution": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "hasAttribution": { "const": true } }, "required": ["hasAttribution"] },
          "then": { "required": ["attribution"] },
          "else": { "not": { "required": ["attribution"] } }
        }
      ]
    },
    "imageStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "hasCaption"],
      "properties": {
        "src": { "type": "string", "format": "uri-reference", "minLength": 1 },
        "alt": { "type": "string" },
        "hasCaption": { "type": "boolean" },
        "caption": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "hasCaption": { "const": true } }, "required": ["hasCaption"] },
          "then": { "required": ["caption"] },
          "else": { "not": { "required": ["caption"] } }
        }
      ]
    },
    "tableStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headers", "rows"],
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "mode": { "enum": ["comparison", "data"] }
      }
    },
    "ctaStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "highlight": { "type": "string", "minLength": 1 }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "startOffset", "endOffset"],
      "properties": {
        "sourceRef": { "$ref": "#/$defs/id" },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 1 }
      }
    },
    "segmentationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "decision", "reason", "producedBlockIds"],
      "properties": {
        "sourceRef": { "$ref": "#/$defs/id" },
        "decision": { "enum": ["split", "keep"] },
        "reason": { "type": "string", "minLength": 1 },
        "producedBlockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "role",
        "content",
        "importance",
        "sourceOrder"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/blockType" },
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "content": { "type": "string" },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceOrder": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "sectionId": { "$ref": "#/$defs/id" },
        "groupId": { "$ref": "#/$defs/id" },
        "relationToPrevious": { "$ref": "#/$defs/relation" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "sourceSpans": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceSpan" }
        },
        "marks": {
          "type": "array",
          "items": { "$ref": "#/$defs/mark" }
        },
        "structure": {
          "oneOf": [
            { "$ref": "#/$defs/headingStructure" },
            { "$ref": "#/$defs/listStructure" },
            { "$ref": "#/$defs/quoteStructure" },
            { "$ref": "#/$defs/imageStructure" },
            { "$ref": "#/$defs/tableStructure" },
            { "$ref": "#/$defs/ctaStructure" }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "heading" } }, "required": ["type", "structure"] },
          "then": { "properties": { "structure": { "$ref": "#/$defs/headingStructure" } } }
        },
        {
          "if": { "properties": { "type": { "const": "list" } }, "required": ["type", "structure"] },
          "then": { "properties": { "structure": { "$ref": "#/$defs/listStructure" } } }
        },
        {
          "if": { "properties": { "type": { "const": "quote" } }, "required": ["type", "structure"] },
          "then": { "properties": { "structure": { "$ref": "#/$defs/quoteStructure" } } }
        },
        {
          "if": { "properties": { "type": { "const": "image" } }, "required": ["type", "structure"] },
          "then": { "properties": { "structure": { "$ref": "#/$defs/imageStructure" } } }
        },
        {
          "if": { "properties": { "type": { "const": "table" } }, "required": ["type", "structure"] },
          "then": { "properties": { "structure": { "$ref": "#/$defs/tableStructure" } } }
        },
        {
          "if": { "properties": { "type": { "const": "cta" } }, "required": ["type", "structure"] },
          "then": { "properties": { "structure": { "$ref": "#/$defs/ctaStructure" } } }
        }
      ]
    }
  }
}
