{
  "specVersion": "1.0",
  "id": "masthead",
  "kind": "masthead",
  "accepts": { "blockTypes": ["article-title"] },
  "slots": [{ "name": "content", "source": "content", "required": true }],
  "fallbackVariant": "editorial",
  "template": "template.html",
  "baseStyles": {
    "root": { "margin": "{alignment.flowMargin}", "padding": "96px 0 0", "border-top": "5px solid {color.accent}", "text-align": "{alignment.left}" },
    "content": { "margin": "0", "color": "{color.ink}", "font-family": "{type.editorial}", "font-size": "{size.title}", "font-weight": "600", "letter-spacing": "0.02em", "line-height": "1.35", "text-align": "{alignment.left}" },
    "rule": { "display": "block", "width": "48px", "height": "1px", "margin": "30px 0 22px", "background-color": "{color.accent}", "opacity": "0.62" },
    "kicker": { "margin": "0", "color": "{color.muted}", "font-family": "{type.body}", "font-size": "{size.meta}", "font-weight": "400", "letter-spacing": "0.22em", "line-height": "{lineHeight.compact}", "text-align": "{alignment.left}" },
    "markEmphasis": { "color": "{color.accent}", "font-family": "{type.editorial}", "font-style": "italic", "font-weight": "300" }
  },
  "variants": [
    { "id": "editorial", "label": "留白题头", "priority": 60, "visualWeight": "strong", "surface": "open", "emphasisCost": 2, "styles": {} },
    { "id": "quiet", "label": "安静题头", "priority": 20, "visualWeight": "strong", "surface": "open", "emphasisCost": 1, "styles": { "root": { "padding": "32px 0 0" }, "content": { "font-size": "26px" }, "rule": { "width": "32px", "margin": "20px 0 16px" } } }
  ]
}
