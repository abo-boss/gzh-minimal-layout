{
  "specVersion": "1.0",
  "id": "champagne-editorial",
  "version": "1.0.0",
  "name": "香槟编辑",
  "description": "香槟金编辑式留白与居中题头，提取 375px 画布、24px 内轨、60/50px 题头节奏。",
  "defaultDensity": "balanced",
  "tokens": {
    "color": {
      "paper": "#FAFAFA",
      "ink": "#2C2E35",
      "body": "#888A92",
      "muted": "#888A92",
      "accent": "#B18F6A",
      "accentLight": "#F6F4F0",
      "line": "#E4DED5"
    },
    "type": {
      "body": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
      "editorial": "\"Songti SC\",STSong,SimSun,serif"
    },
    "size": {
      "title": "22px",
      "heading": "16px",
      "subheading": "24px",
      "body": "15px",
      "meta": "14px",
      "focus": "20px"
    },
    "lineHeight": {
      "title": "1.7",
      "heading": "1.7",
      "body": "2.2",
      "compact": "1.75",
      "focus": "2"
    },
    "alignment": {
      "flowMargin": "0",
      "insetMargin": "0 0 0 24px",
      "insetWidth": "calc(100% - 24px)",
      "focusMargin": "0 auto",
      "focusWidth": "82%",
      "ornamentLeft": "-12px",
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#FAFAFA",
      "padding": "0 24px 72px"
    }
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 8,
        "flow": 16,
        "break": 28,
        "turn": 40,
        "section": 56,
        "release": 68
      },
      "balanced": {
        "close": 12,
        "flow": 22,
        "break": 36,
        "turn": 52,
        "section": 72,
        "release": 88
      },
      "airy": {
        "close": 16,
        "flow": 28,
        "break": 44,
        "turn": 64,
        "section": 88,
        "release": 108
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "close",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "break",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.16,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/lead-image/component.json",
    "components/lead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/prose/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/ending/component.json",
    "components/cta/component.json"
  ]
}
