{
  "specVersion": "1.0",
  "id": "quote",
  "kind": "quote",
  "accepts": { "blockTypes": ["quote"] },
  "slots": [
    { "name": "content", "source": "quote-content", "required": true },
    { "name": "attribution", "source": "quote-attribution", "required": false }
  ],
  "fallbackVariant": "inset",
  "template": "template.html",
  "baseStyles": {
    "root": { "position": "relative", "margin": "{alignment.insetMargin}", "max-width": "{alignment.insetWidth}", "padding": "2px 0 2px 16px", "border-left": "1px solid {color.accent}", "box-sizing": "border-box" },
    "mark": { "display": "none", "color": "{color.accentLight}", "font-family": "{type.editorial}", "font-size": "48px", "line-height": "1" },
    "content": { "margin": "0", "color": "{color.accent}", "font-family": "{type.editorial}", "font-size": "17px", "font-style": "normal", "font-weight": "300", "letter-spacing": "0.05em", "line-height": "{lineHeight.focus}", "text-align": "{alignment.left}" },
    "attribution": { "margin": "10px 0 0", "color": "{color.muted}", "font-family": "{type.body}", "font-size": "{size.meta}", "letter-spacing": "0.08em", "line-height": "{lineHeight.compact}", "text-align": "{alignment.right}" }
  },
  "variants": [
    { "id": "pull", "label": "深色卡片引用", "priority": 70, "visualWeight": "medium", "surface": "panel", "emphasisCost": 1, "accepts": { "roles": ["key-insight", "pull-quote"] }, "styles": { "root": { "margin": "24px 0", "max-width": "100%", "padding": "24px", "background-color": "{color.ink}", "border-left": "0 solid transparent", "border-radius": "16px", "text-align": "{alignment.center}" }, "mark": { "display": "block", "margin": "0 0 8px", "text-align": "{alignment.center}", "color": "{color.accent}" }, "content": { "color": "{color.paper}", "font-size": "{size.focus}", "font-weight": "500", "letter-spacing": "0.07em", "text-align": "{alignment.center}" }, "attribution": { "text-align": "{alignment.center}" } } },
    { "id": "inset", "label": "缩进轻引用", "priority": 35, "visualWeight": "quiet", "surface": "open", "emphasisCost": 0, "styles": {} }
  ]
}
