{
  "specVersion": "1.0",
  "id": "cta",
  "kind": "cta",
  "accepts": { "blockTypes": ["cta"] },
  "slots": [
    { "name": "eyebrow", "source": "cta-eyebrow", "required": false },
    { "name": "prompt", "source": "cta-prompt", "required": true },
    { "name": "highlight", "source": "cta-highlight", "required": false }
  ],
  "fallbackVariant": "quiet",
  "template": "template.html",
  "baseStyles": {
    "root": { "margin": "0", "padding": "30px 20px", "background-color": "{color.paperWarm}", "border-top": "1px solid {color.line}", "border-bottom": "1px solid {color.line}" },
    "eyebrow": { "margin": "0 0 14px", "color": "{color.champagne}", "font-family": "{type.body}", "font-size": "11px", "font-weight": "600", "letter-spacing": "0.16em", "line-height": "1.6" },
    "prompt": { "margin": "0", "color": "{color.muted}", "font-family": "{type.body}", "font-size": "14px", "font-weight": "400", "letter-spacing": "0.045em", "line-height": "2" },
    "highlight": { "display": "block", "margin-top": "12px", "color": "{color.forest}", "font-family": "{type.editorial}", "font-size": "15px", "font-weight": "600", "letter-spacing": "0.04em", "line-height": "2" }
  },
  "variants": [
    { "id": "question", "label": "文末提问", "priority": 55, "visualWeight": "medium", "surface": "panel", "emphasisCost": 1, "styles": {} },
    { "id": "quiet", "label": "轻互动", "priority": 20, "visualWeight": "quiet", "surface": "open", "emphasisCost": 0, "styles": { "root": { "padding": "22px 0", "background-color": "transparent" } } }
  ]
}
