{
  "specVersion": "1.0",
  "id": "heading",
  "kind": "heading",
  "accepts": { "blockTypes": ["heading"] },
  "slots": [
    { "name": "marker", "source": "heading-marker", "required": false, "format": "two-digit-arabic" },
    { "name": "content", "source": "heading-title", "required": true }
  ],
  "fallbackVariant": "subtle",
  "template": "template.html",
  "baseStyles": {
    "root": { "margin": "0", "padding": "0" },
    "markerRow": { "display": "block", "margin-bottom": "13px" },
    "marker": { "display": "inline", "color": "{color.champagne}", "font-family": "{type.editorial}", "font-size": "42px", "font-style": "italic", "font-weight": "400", "letter-spacing": "0", "line-height": "1" },
    "line": { "display": "inline-block", "width": "64px", "height": "1px", "margin": "0 0 10px 14px", "background-color": "{color.champagneWash}", "opacity": "0.8" },
    "content": { "margin": "0", "color": "{color.forest}", "font-family": "{type.editorial}", "font-size": "20px", "font-weight": "600", "letter-spacing": "0.04em", "line-height": "{lineHeight.heading}", "text-align": "{alignment.left}" }
  },
  "variants": [
    { "id": "section", "label": "数字章节", "priority": 40, "visualWeight": "medium", "surface": "open", "emphasisCost": 1, "accepts": { "levels": [1, 2] }, "styles": {} },
    { "id": "subtle", "label": "无编号章节", "priority": 10, "visualWeight": "medium", "surface": "open", "emphasisCost": 1, "styles": { "markerRow": { "display": "none", "margin-bottom": "0" }, "content": { "font-size": "19px", "letter-spacing": "0.03em" } } }
  ]
}
