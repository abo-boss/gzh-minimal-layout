{
  "specVersion": "1.0",
  "id": "quote",
  "kind": "quote",
  "accepts": { "blockTypes": ["quote"] },
  "slots": [{ "name": "content", "source": "quote-content", "required": true }, { "name": "attribution", "source": "quote-attribution", "required": false }],
  "fallbackVariant": "quiet",
  "template": "template.html",
  "baseStyles": {
    "root": { "position": "relative", "margin": "0", "padding": "26px 22px", "background-color": "{color.paperWarm}", "border": "1px solid {color.line}", "border-left": "1px solid {color.line}", "border-radius": "3px", "overflow": "hidden" },
    "watermark": { "position": "absolute", "top": "-22px", "left": "-3px", "z-index": "0", "color": "{color.champagneWash}", "font-family": "{type.editorial}", "font-size": "84px", "font-weight": "400", "line-height": "1", "opacity": "0.7" },
    "content": { "position": "relative", "z-index": "1", "margin": "0", "color": "{color.forestSoft}", "font-family": "{type.editorial}", "font-size": "16px", "font-style": "normal", "font-weight": "400", "letter-spacing": "0.04em", "line-height": "2.05", "text-align": "{alignment.left}" },
    "attribution": { "position": "relative", "z-index": "1", "margin": "12px 0 0", "color": "{color.muted}", "font-family": "{type.body}", "font-size": "{size.meta}", "font-style": "normal", "letter-spacing": "0.04em", "line-height": "{lineHeight.compact}", "text-align": "{alignment.right}" }
  },
  "variants": [
    { "id": "paper", "label": "纸感引言", "priority": 50, "visualWeight": "medium", "surface": "panel", "emphasisCost": 1, "styles": {} },
    { "id": "quiet", "label": "轻引言", "priority": 20, "visualWeight": "quiet", "surface": "open", "emphasisCost": 0, "styles": { "root": { "padding": "0 0 0 {alignment.insetPadding}", "background-color": "transparent", "border-radius": "0", "overflow": "hidden" }, "watermark": { "display": "none" } } }
  ]
}
