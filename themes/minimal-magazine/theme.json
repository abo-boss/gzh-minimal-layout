{
  "specVersion": "1.0",
  "id": "minimal-magazine",
  "version": "1.0.0",
  "name": "极简杂志",
  "description": "纯白杂志纸张与极宽字距，提取 640px 容器、40px 横向内边距和 55/60px 题头节奏。",
  "defaultDensity": "balanced",
  "tokens": {
    "color": {
      "paper": "#FFFFFF",
      "ink": "#2B2F36",
      "body": "#787D85",
      "muted": "#787D85",
      "accent": "#1E293B",
      "accentLight": "#F7F8FA",
      "line": "#E2E8F0"
    },
    "type": {
      "body": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
      "editorial": "\"Songti SC\",STSong,SimSun,serif"
    },
    "size": {
      "title": "20px",
      "heading": "16px",
      "subheading": "22px",
      "body": "15px",
      "meta": "13px",
      "focus": "18px"
    },
    "lineHeight": {
      "title": "1.5",
      "heading": "1.5",
      "body": "2.3",
      "compact": "1.75",
      "focus": "2.1"
    },
    "alignment": {
      "flowMargin": "0",
      "insetMargin": "0 0 0 24px",
      "insetWidth": "calc(100% - 24px)",
      "focusMargin": "0 auto",
      "focusWidth": "80%",
      "ornamentLeft": "-16px",
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#FFFFFF",
      "padding": "0 40px 88px"
    }
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 8,
        "flow": 18,
        "break": 36,
        "turn": 48,
        "section": 68,
        "release": 84
      },
      "balanced": {
        "close": 12,
        "flow": 24,
        "break": 44,
        "turn": 60,
        "section": 84,
        "release": 104
      },
      "airy": {
        "close": 16,
        "flow": 30,
        "break": 52,
        "turn": 72,
        "section": 100,
        "release": 124
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "close",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "break",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.16,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/lead-image/component.json",
    "components/lead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/prose/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/ending/component.json",
    "components/cta/component.json"
  ]
}
