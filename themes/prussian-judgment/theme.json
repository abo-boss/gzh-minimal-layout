{
  "specVersion": "1.0",
  "id": "prussian-judgment",
  "version": "1.0.0",
  "name": "冷墨蓝判断",
  "description": "冷墨蓝封面与窄幅章节，提取 375px 画布、24px 内容轨和 4/5 头图比例。",
  "recommendation": {
    "summary": "冷峻、严肃、论证密度高的判断型文章",
    "articleTypes": ["opinion-knowledge", "other"],
    "tones": ["cool", "serious", "analytical", "academic"],
    "structurePatterns": ["argument-evidence-conclusion", "other"]
  },
  "defaultDensity": "balanced",
  "tokens": {
    "color": {
      "paper": "#FCFCFD",
      "ink": "#242830",
      "body": "#5C6572",
      "muted": "#5C6572",
      "accent": "#162A45",
      "accentLight": "#EEF3F8",
      "line": "#D7DEE6"
    },
    "type": {
      "body": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
      "editorial": "\"Songti SC\",STSong,SimSun,serif"
    },
    "size": {
      "title": "22px",
      "heading": "14px",
      "subheading": "22px",
      "body": "14px",
      "meta": "14px",
      "focus": "20px"
    },
    "lineHeight": {
      "title": "1.5",
      "heading": "1.5",
      "body": "2.25",
      "compact": "1.75",
      "focus": "2.25"
    },
    "alignment": {
      "flowMargin": "0",
      "insetMargin": "0 0 0 24px",
      "insetWidth": "calc(100% - 24px)",
      "focusMargin": "0 auto",
      "focusWidth": "78%",
      "ornamentLeft": "-14px",
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#FCFCFD",
      "padding": "0 24px 72px"
    }
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 8,
        "flow": 16,
        "break": 28,
        "turn": 40,
        "section": 56,
        "release": 68
      },
      "balanced": {
        "close": 12,
        "flow": 22,
        "break": 36,
        "turn": 52,
        "section": 72,
        "release": 88
      },
      "airy": {
        "close": 16,
        "flow": 28,
        "break": 44,
        "turn": 64,
        "section": 88,
        "release": 108
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "close",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "break",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.16,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/lead-image/component.json",
    "components/lead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/prose/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/ending/component.json",
    "components/cta/component.json"
  ]
}
