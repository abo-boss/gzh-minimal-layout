{
  "specVersion": "1.0",
  "id": "list",
  "kind": "list",
  "accepts": { "blockTypes": ["list"] },
  "slots": [{ "name": "items", "source": "list-items", "required": true }],
  "fallbackVariant": "compact",
  "template": "template.html",
  "baseStyles": {
    "root": { "margin": "0", "padding": "0" },
    "list": { "margin": "0", "padding-left": "1.5em", "color": "{color.ink}", "font-family": "{type.body}", "font-size": "{size.body}", "line-height": "{lineHeight.body}" },
    "item": { "margin-bottom": "8px", "padding": "0" }
  },
  "variants": [
    {
      "id": "editorial",
      "label": "编辑列表",
      "priority": 50,
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "styles": { "list": { "padding-left": "1.65em" }, "item": { "margin-bottom": "10px" } }
    },
    {
      "id": "compact",
      "label": "紧凑列表",
      "priority": 20,
      "visualWeight": "quiet",
      "surface": "open",
      "emphasisCost": 0,
      "styles": { "item": { "margin-bottom": "6px" } }
    }
  ]
}
