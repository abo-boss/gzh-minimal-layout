{
  "specVersion": "1.0",
  "id": "prose",
  "kind": "prose",
  "accepts": {
    "blockTypes": ["article-subtitle", "metadata", "lead", "paragraph", "quote", "list", "image", "divider", "callout", "step", "table", "code"]
  },
  "slots": [{ "name": "content", "source": "content", "required": true }],
  "fallbackVariant": "body",
  "template": "template.html",
  "baseStyles": {
    "root": { "margin": "0", "padding": "0" },
    "content": {
      "margin": "0",
      "color": "{color.ink}",
      "font-family": "{type.body}",
      "font-size": "{size.body}",
      "font-weight": "400",
      "letter-spacing": "0.02em",
      "line-height": "{lineHeight.body}"
    }
  },
  "variants": [
    {
      "id": "lead",
      "label": "导语",
      "priority": 40,
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "accepts": { "blockTypes": ["lead"] },
      "styles": { "content": { "font-size": "17px", "font-weight": "500", "line-height": "1.85" } }
    },
    {
      "id": "inset",
      "label": "侧线停顿",
      "priority": 40,
      "visualWeight": "medium",
      "surface": "open",
      "emphasisCost": 1,
      "accepts": { "blockTypes": ["quote", "callout"] },
      "styles": {
        "root": { "border-left": "2px solid {color.accent}", "padding-left": "16px" },
        "content": { "color": "{color.muted}", "font-family": "{type.editorial}", "font-style": "italic" }
      }
    },
    {
      "id": "muted",
      "label": "轻信息",
      "priority": 40,
      "visualWeight": "quiet",
      "surface": "open",
      "emphasisCost": 0,
      "accepts": { "blockTypes": ["article-subtitle", "metadata", "divider"] },
      "styles": {
        "content": { "color": "{color.muted}", "font-size": "{size.meta}", "line-height": "{lineHeight.compact}" }
      }
    },
    {
      "id": "body",
      "label": "正文流",
      "priority": 10,
      "visualWeight": "quiet",
      "surface": "open",
      "emphasisCost": 0,
      "styles": {}
    }
  ]
}
