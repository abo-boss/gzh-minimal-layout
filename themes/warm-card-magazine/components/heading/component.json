{
  "specVersion": "1.0",
  "id": "heading",
  "kind": "heading",
  "accepts": { "blockTypes": ["heading"], "levels": [1, 2] },
  "slots": [
    { "name": "marker", "source": "heading-marker", "required": false, "format": "two-digit-arabic" },
    { "name": "content", "source": "heading-title", "required": true }
  ],
  "fallbackVariant": "plain",
  "template": "template.html",
  "baseStyles": {
    "root": { "position": "relative", "margin": "0 0 20px", "padding": "0 0 12px", "border-bottom": "1px solid {color.line}", "text-align": "{alignment.left}" },
    "marker": { "position": "absolute", "top": "-2px", "right": "4px", "z-index": "0", "color": "{color.accentLight}", "font-family": "{type.editorial}", "font-size": "30px", "font-style": "normal", "font-weight": "300", "letter-spacing": "0", "line-height": "1", "opacity": "0.9" },
    "content": { "position": "relative", "z-index": "1", "display": "inline-block", "max-width": "100%", "margin": "0", "padding": "0 0 11px", "border-bottom": "1px solid {color.line}", "color": "{color.ink}", "font-family": "{type.editorial}", "font-size": "{size.heading}", "font-weight": "400", "letter-spacing": "0.045em", "line-height": "{lineHeight.heading}", "text-align": "{alignment.left}" }
  },
  "variants": [
    { "id": "numbered", "label": "越界编号章节", "priority": 70, "visualWeight": "medium", "surface": "open", "emphasisCost": 1, "accepts": { "roles": ["section-heading"] }, "styles": {} },
    { "id": "plain", "label": "无编号章节", "priority": 20, "visualWeight": "medium", "surface": "open", "emphasisCost": 1, "styles": { "marker": { "display": "none" } } }
  ]
}
