{
  "specVersion": "1.0",
  "id": "prose",
  "kind": "prose",
  "accepts": { "blockTypes": ["article-subtitle", "metadata", "lead", "paragraph", "quote", "list", "image", "divider", "callout", "step", "table", "code"] },
  "slots": [{ "name": "content", "source": "content", "required": true }],
  "fallbackVariant": "body",
  "template": "template.html",
  "baseStyles": {
    "root": { "margin": "{alignment.flowMargin}", "padding": "24px", "background-color": "{color.paper}", "border": "1px solid {color.line}", "border-radius": "24px" },
    "content": { "margin": "0", "color": "{color.body}", "font-family": "{type.body}", "font-size": "{size.body}", "font-weight": "300", "letter-spacing": "0.045em", "line-height": "{lineHeight.body}", "text-align": "{alignment.justify}", "text-align-last": "{alignment.left}" },
    "markStrong": { "color": "{color.ink}", "font-weight": "600", "background-image": "linear-gradient(transparent 72%, {color.accentLight} 72%)" },
    "markKeyword": { "color": "{color.ink}", "font-weight": "600", "background-color": "{color.accentLight}" },
    "markEmphasis": { "color": "{color.accent}", "font-family": "{type.editorial}", "font-style": "italic" },
    "markQuote": { "color": "{color.accent}", "font-family": "{type.editorial}", "font-style": "italic" }
  },
  "variants": [
    { "id": "focus", "label": "窄幅居中金句", "priority": 75, "visualWeight": "medium", "surface": "open", "emphasisCost": 1, "accepts": { "roles": ["key-insight"] }, "styles": { "root": { "margin": "{alignment.focusMargin}", "max-width": "78%", "padding": "44px 0" }, "content": { "color": "{color.ink}", "font-family": "{type.editorial}", "font-size": "{size.focus}", "font-weight": "300", "letter-spacing": "0.075em", "line-height": "{lineHeight.focus}", "text-align": "{alignment.center}", "text-align-last": "{alignment.center}" } } },
    { "id": "inset", "label": "缩进解释", "priority": 60, "visualWeight": "medium", "surface": "open", "emphasisCost": 1, "accepts": { "blockTypes": ["callout"] }, "styles": { "root": { "margin": "{alignment.insetMargin}", "max-width": "{alignment.insetWidth}", "padding": "2px 0 2px 16px", "border-left": "1px solid {color.accent}", "box-sizing": "border-box" }, "content": { "color": "{color.accent}", "font-family": "{type.editorial}", "font-size": "16px", "font-weight": "300", "letter-spacing": "0.05em", "text-align": "{alignment.left}", "text-align-last": "{alignment.left}" } } },
    { "id": "muted", "label": "轻信息", "priority": 50, "visualWeight": "quiet", "surface": "open", "emphasisCost": 0, "accepts": { "blockTypes": ["article-subtitle", "metadata", "divider"] }, "styles": { "content": { "color": "{color.muted}", "font-size": "{size.meta}", "letter-spacing": "0.14em", "line-height": "{lineHeight.compact}", "text-align": "{alignment.left}", "text-align-last": "{alignment.left}" } } },
    { "id": "body", "label": "正文轨", "priority": 10, "visualWeight": "quiet", "surface": "open", "emphasisCost": 0, "styles": {} }
  ]
}
