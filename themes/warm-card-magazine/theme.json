{
  "specVersion": "1.0",
  "id": "warm-card-magazine",
  "version": "1.0.0",
  "name": "暖灰卡片",
  "description": "暖灰杂志背景与卡片章节，提取 576px 内容宽度、24/36px 卡片内距和 24px 模块间距。",
  "defaultDensity": "balanced",
  "tokens": {
    "color": {
      "paper": "#F4F3EE",
      "ink": "#262626",
      "body": "#77736D",
      "muted": "#77736D",
      "accent": "#9A8060",
      "accentLight": "#EEE9E0",
      "line": "#D9D2C8"
    },
    "type": {
      "body": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
      "editorial": "\"Songti SC\",STSong,SimSun,serif"
    },
    "size": {
      "title": "18px",
      "heading": "15px",
      "subheading": "22px",
      "body": "14px",
      "meta": "13px",
      "focus": "17px"
    },
    "lineHeight": {
      "title": "1.5",
      "heading": "1.5",
      "body": "2",
      "compact": "1.75",
      "focus": "2"
    },
    "alignment": {
      "flowMargin": "0",
      "insetMargin": "0 0 0 24px",
      "insetWidth": "calc(100% - 24px)",
      "focusMargin": "0 auto",
      "focusWidth": "82%",
      "ornamentLeft": "-14px",
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#F4F3EE",
      "padding": "0 24px 88px"
    }
  },
  "rhythm": {
    "modes": {
      "dense": {
        "close": 8,
        "flow": 18,
        "break": 32,
        "turn": 44,
        "section": 56,
        "release": 68
      },
      "balanced": {
        "close": 12,
        "flow": 24,
        "break": 40,
        "turn": 56,
        "section": 72,
        "release": 88
      },
      "airy": {
        "close": 16,
        "flow": 30,
        "break": 48,
        "turn": 68,
        "section": 88,
        "release": 108
      }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "close",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "break",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.16,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/lead-image/component.json",
    "components/lead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/prose/component.json",
    "components/list/component.json",
    "components/quote/component.json",
    "components/ending/component.json",
    "components/cta/component.json"
  ]
}
