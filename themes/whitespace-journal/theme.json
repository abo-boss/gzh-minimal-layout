{
  "specVersion": "1.0",
  "id": "whitespace-journal",
  "version": "1.0.0",
  "name": "留白志",
  "description": "温暖纸张上的克制杂志排版。以正文、缩进、窄幅居中、中轴与装饰越界五条对齐轨道建立非对称但稳定的阅读节奏。",
  "defaultDensity": "balanced",
  "tokens": {
    "color": {
      "paper": "#F9F8F6",
      "ink": "#1A1C1A",
      "body": "#4E4F4C",
      "muted": "#7A7A78",
      "accent": "#948777",
      "accentLight": "#EFECE6",
      "line": "#DDD8D0"
    },
    "type": {
      "body": "-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif",
      "editorial": "\"Songti SC\",STSong,SimSun,serif"
    },
    "size": {
      "title": "28px",
      "heading": "20px",
      "subheading": "15px",
      "body": "14px",
      "meta": "11px",
      "focus": "19px"
    },
    "lineHeight": {
      "title": "1.45",
      "heading": "1.55",
      "body": "2.1",
      "compact": "1.75",
      "focus": "2"
    },
    "alignment": {
      "flowMargin": "0",
      "insetMargin": "0 0 0 24px",
      "insetWidth": "calc(100% - 24px)",
      "focusMargin": "0 auto",
      "focusWidth": "82%",
      "ornamentLeft": "-14px",
      "left": "left",
      "center": "center",
      "right": "right",
      "justify": "justify"
    },
    "canvas": {
      "background": "#F9F8F6",
      "padding": "0 20px 72px"
    }
  },
  "rhythm": {
    "modes": {
      "dense": { "close": 8, "flow": 16, "break": 28, "turn": 40, "section": 56, "release": 72 },
      "balanced": { "close": 12, "flow": 22, "break": 36, "turn": 52, "section": 72, "release": 92 },
      "airy": { "close": 16, "flow": 28, "break": 44, "turn": 64, "section": 88, "release": 112 }
    },
    "relationMap": {
      "default": "flow",
      "same-group": "close",
      "continuation": "flow",
      "new-argument": "break",
      "turning-point": "turn",
      "before-strong-block": "turn",
      "after-strong-block": "break",
      "new-section": "section",
      "before-ending": "release"
    }
  },
  "budgets": {
    "maxStrongPerSection": 1,
    "maxSurfaceRatio": 0.12,
    "noAdjacentStrong": true
  },
  "componentPaths": [
    "components/masthead/component.json",
    "components/lead-image/component.json",
    "components/lead/component.json",
    "components/heading/component.json",
    "components/subheading/component.json",
    "components/prose/component.json",
    "components/quote/component.json",
    "components/list/component.json",
    "components/ending/component.json",
    "components/cta/component.json"
  ]
}
